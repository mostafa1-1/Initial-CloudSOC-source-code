# CloudSOC - Live Node/React application (local SQLite)
NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/cloudsoc.db
DATABASE_URL=sqlite:///./data/cloudsoc.db
# Leave unset unless the application is behind one trusted HTTPS reverse proxy.
# TRUST_PROXY=1
# Optional; otherwise the Threat Intelligence page clearly uses Local Demonstration Mode.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Firebase Web SDK (copy values from Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=cloudsoc-5f44a
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (server only; download a service account JSON from Firebase Console)
FIREBASE_PROJECT_ID=cloudsoc-5f44a
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
